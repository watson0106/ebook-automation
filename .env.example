# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini / Imagen 3 API
GOOGLE_API_KEY=your_google_api_key_here

# Draft2Digital アカウント
D2D_EMAIL=your_d2d_email@example.com
D2D_PASSWORD=your_d2d_password_here

# 著者情報（D2Dへの投稿に使用）
AUTHOR_NAME=著者名
AUTHOR_BIO=著者プロフィール

# Google Docs 出力
# サービスアカウントJSONファイルのパス（Google Cloud Consoleで作成）
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# 書き出し先 Google Document ID（URLの /d/XXXXXXX/edit の XXXXXXX 部分）
GDOC_DOCUMENT_ID=146cyr_6rRT2YJ0MgOOYtE3Mk-2Y9JeMWgI0UWEHfGz4

# 設定
HEADLESS_BROWSER=true   # false にするとブラウザが表示される（デバッグ用）
RESEARCH_INTERVAL_DAYS=7
